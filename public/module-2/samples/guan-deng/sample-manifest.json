  "panels": [
    {
      "id": "opening",
      "label": "起",
      "image": "comic-panel-01.png",
      "sourcePart": "opening",
      "sentence": "夜里，主人公在卧室拉紧窗帘，路灯的亮光仍落在枕头上。",
      "caption": "窗帘拉紧了，枕头上还是亮的。",
      "evidence": "我走到窗前，把窗帘往墙边拉紧，白光又从另一侧漏了进来，照在枕头上。",
      "choice": "保留睡眠受到影响的处境，用亮斑和拉窗帘的动作表现困扰。"
    },
    {
      "id": "development",
      "label": "承",
      "image": "comic-panel-02.png",
      "sourcePart": "development",
      "sentence": "白天，陈叔叔在楼门口扶着自行车指向台阶，主人公放下手机听他说明情况。",
      "caption": "“灯暗下来，台阶就看不清了。”",
      "evidence": "他扶着车把，说以前这里暗，自己下台阶都得先停一下。",
      "choice": "集中呈现邻居的需要，省略发照片和等待回复的过程，以旁白衔接。"
    },
    {
      "id": "turn",
      "label": "转",
      "image": "comic-panel-03.png",
      "sourcePart": "turn",
      "sentence": "夜里，主人公蹲在楼门口查看阴影中的台阶，陈叔叔在旁边指向台阶边沿。",
      "caption": "“灯亮着，台阶仍看不清。能来看看光照到的位置吗？”",
      "evidence": "我蹲下来，台阶边沿只剩一条模糊的线。",
      "choice": "用蹲下观察的动作呈现新发现，用文字补充请求的变化。画中窗户亮不能独自证明光源，须结合原文。"
    },
    {
      "id": "ending",
      "label": "合",
      "image": "comic-panel-04.png",
      "sourcePart": "ending",
      "sentence": "调整后，主人公在卧室放下手机，枕边的亮斑已经淡了。",
      "caption": "物业调整后，两处都好些了。我们还要再留意几天。",
      "evidence": "这一回，我不用再把枕头往里面挪了。",
      "choice": "以枕头照应开头，旁白交代调整和台阶的改善，保留继续观察的余地。"
    }
  ],
